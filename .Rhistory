install.packages("tidyr")
install.packages("ez")
library("tidyr")
library("ez")
# Set randomization seed so that everyone will get the same results
set.seed(123)
# Number of participants
sampleSize <- 30
# Factor 1: actual origin of the audio clip
audioOrigin <- c("AI", "Human")
# Factor 2: label shown to the participant before listening
audioLabel <- c("LabeledAI", "LabeledHuman")
# Number of clips per condition
nClipspercondition <- 2
df <- expand.grid(
participant = 1:sampleSize,
actual_origin = audioOrigin,
label = audioLabel,
clip = 1:nClipspercondition
)
# Factors
df$participant <- as.factor(df$participant)
df$actual_origin <- factor(df$actual_origin, levels = c("AI","Human"))
df$label <- factor(df$label, levels = c("LabeledAI", "LabeledHuman"))
# Sorting Rows
df <- df[order(df$participant, df$actual_origin, df$label, df$clip),]
row.names(df) <- NULL # Reorders the sequence
# Looking at first couple rows
head(df)
# Expected means and shared SD
cv_AI_mean <- 0.10 # lower variability = more robotic tapping
cv_human_mean <- 0.18 # higher variability = more human tapping
cv_SD <- 0.04
# creating an empty column
df$ITI_CV <- NA
# Filling in AI trials
df$ITI_CV[df$actual_origin == "AI"] <- rnorm(
sum(df$actual_origin == "AI"),
mean = cv_AI_mean,
sd = cv_SD
) ## Vector arrangment that filters through all trials and returns TRUE/FALSE. Sum all TRUE trials (b/c they equal 1)
## and return sum amount of numbers centered around the mean.
# Filling in Human trials
df$ITI_CV[df$actual_origin == "Human"] <- rnorm(
sum(df$actual_origin == "Human"),
mean = cv_human_mean,
sd = cv_SD
)
# Note: CV cannot be negative
df$ITI_CV <- pmax(df$ITI_CV,0.01) # look through df$ITI_CV, compare to 0.01 which we treat as a floor If less, then replace with 0.01
# Range of valid rating values
possible_ratings <- 1:7
# Expected means and shared SD
liking_labeledAI_mean <- 3.5
liking_labeledHuman_mean <- 5.0
liking_SD <- 1.2
# Creating an empty column
df$liking <- NA
# Filling in Labeled AI trials
df$liking[df$label == "LabeledAI"] <- sample(
possible_ratings,
size = sum(df$label == "LabeledAI"),
replace = TRUE,
prob = dnorm(possible_ratings,mean=liking_labeledAI_mean, sd=liking_SD)
) # used the sample function here because liking is discrete. dnorm uses the normal distribution such that values near the mean have a higher probability
# Filling in Labeled Human trials
df$liking[df$label == "LabeledHuman"] <- sample(
possible_ratings,
size = sum(df$label == "LabeledHuman"),
replace = TRUE,
prob = dnorm(possible_ratings,mean=liking_labeledHuman_mean, sd=liking_SD)
)
# perceived human likeness = phl
phl_LabeledAI_mean <- 3.0
phl_LabeledHuman_mean <- 5.2
phl_SD <- 1.2
df$HumanLikeness <- NA
df$HumanLikeness[df$label == "LabeledAI"] <- sample(
possible_ratings,
size = sum(df$label == "LabeledAI"),
replace = TRUE,
prob = dnorm(possible_ratings, mean=phl_LabeledAI_mean, sd=phl_SD)
)
df$HumanLikeness[df$label == "LabeledHuman"] <- sample(
possible_ratings,
size = sum(df$label == "LabeledHuman"),
replace = TRUE,
prob = dnorm(possible_ratings, mean=phl_LabeledHuman_mean, sd=phl_SD)
)
# df <- df[df$passed_soundcheck == TRUE,]
# df <- df[df$n_taps >= 10,]
max_trials <- length(audioOrigin) * length(audioLabel) * nClipspercondition
trial_counts <- aggregate(clip~participant, data = df, FUN =length)
colnames(trial_counts) <- c("Participants", "nTrials")
trial_counts$complete <- trial_counts$nTrials / max_trials
excluded_participants <- trial_counts$Participants[trial_counts$complete<0.75]
cat("Participants excluded for missing data:", length(excluded_participants), "\n")
hist(df$ITI_CV,
main = "ITI CV for all trials",
xlab = "ITI Coeffecient of variation",
col = "blue",
breaks = 10)
par(mfrow=c(1,2))
hist(df$ITI_CV[df$actual_origin == "AI"],
main = "ITI CV for AI Audio Clips",
xlab = "ITI CV",
col = "red")
hist(df$ITI_CV[df$actual_origin == "Human"],
main = "ITI CV for Human Composed Audio Clips",
xlab = "ITI CV",
col = "blue")
par(mfrow = c(1,1)) # reset plot
par(mfrow=c(1,2))
hist(df$liking[df$label == "LabeledAI"],
main = "Liking for Audio Labeled AI",
xlab = "Liking (1-7)",
xlim = c(1,7),
breaks = 7,
col = "green")
hist(df$liking[df$label == "LabeledHuman"],
main = "Liking for Audio Labeled Human Composed",
xlab = "Liking (1-7)",
xlim = c(1,7),
breaks = 7,
col = "lightblue")
par(mfrow = c(1,1)) # reset plot
